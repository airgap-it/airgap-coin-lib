.DS_Store
.idea
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# next.js build output
.next
.vscode

# tslint reports
lint-reports

dist/

# Vendored dependencies are checked-in source, not build output. Some upstream packages ship their
# entrypoint under dist/ (bech32-2.0.0), which the rule above would silently swallow — the files
# stay on disk locally, so it only surfaces as a missing module in a clean checkout or CI build.
# Both lines are required: git will not descend into an excluded directory to re-include its files.
!packages/core/src/dependencies/**/dist/
!packages/core/src/dependencies/**/dist/**

config.ts

# generated by scripts/generate-vendored-lockfile.js for the vendored dependency scan
.vendored-scan
vendored-scan-report
npm-scan-report